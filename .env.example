# Copy to .env and fill in. .env is gitignored — never commit the real key.

# OctoPrint. Settings -> Application Keys on the Pi.
# An application key is preferable to the global one: individually revocable.
#
# These must be in .env, not exported in your shell. An MCP client spawns the server
# with a scrubbed environment (HOME, LOGNAME, PATH, SHELL, TERM, USER and nothing
# else), so an exported variable never arrives. src/evee/config.py reads the file.
OCTOPRINT_URL=http://octopi.local
OCTOPRINT_API_KEY=

# No LLM credentials are needed. Parameter extraction is done by whatever model
# your MCP client already runs — see BUILD_PLAN.md § Portability.

# Push notifications when a print finishes, fails, or the printer drops offline.
# Optional — the rest of the system works without it.
#
# DON'T FILL THIS IN BY HAND. Run:
#
#     python -m evee.notify --setup
#
# It generates a topic, walks you through subscribing on your phone, sends a real
# test notification, and only writes this file once you confirm your phone buzzed.
#
# Why generated rather than chosen: on a public ntfy server the topic IS the
# credential. Anyone who knows the string can read your notifications and send you
# fake ones — and "a print just finished" tells a stranger you are not at home.
# "shiv-printer" is guessable; "evee-9f3a2c7b41d8" is not.
NTFY_TOPIC=
# Override only if you self-host ntfy. Defaults to https://ntfy.sh.
NTFY_SERVER=
