# Copy to .env and fill in. .env is gitignored — never commit the real key.

# OctoPrint. Settings -> Application Keys on the Pi.
# An application key is preferable to the global one: individually revocable.
#
# These must be in .env, not exported in your shell. An MCP client spawns the server
# with a scrubbed environment (HOME, LOGNAME, PATH, SHELL, TERM, USER and nothing
# else), so an exported variable never arrives. src/vtp/config.py reads the file.
OCTOPRINT_URL=http://octopi.local
OCTOPRINT_API_KEY=

# No LLM credentials are needed. Parameter extraction is done by whatever model
# your MCP client already runs — see BUILD_PLAN.md § Portability.

# Push notifications for the Phase 6 daemon (`python -m vtp.notify`). Optional — the
# rest of the system works without it.
#
# Pick a LONG RANDOM topic name and subscribe to it in the ntfy app. On the public
# server the topic is the only thing protecting it: anyone who knows the string can
# read your notifications and send you fake ones. "shiv-printer" is a bad topic;
# "vtp-9f3a2c7b41d8" is a reasonable one.
NTFY_TOPIC=
# Override only if you self-host ntfy. Defaults to https://ntfy.sh.
NTFY_SERVER=
